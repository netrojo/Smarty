# Firebase — replace with your project values
#
# databaseURL MUST use the <project>-default-rtdb.<region>.firebasedatabase.app
# form. The legacy <project>-default-rtdb.firebaseio.com host still resolves for
# browsers, but it serves a certificate for the .firebasedatabase.app name, so
# strict TLS clients such as the ESP32 fail hostname verification against it.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.us-central1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id